---
import ActionStep from '../components/ActionStep.astro';
import '../styles/global.css';
import resumeData from '../../data/resume.json';

const { personal, experience, skills, certifications } = resumeData;

// convertion from MM/YYYY to YYYY-MM-01, 
const parseDate = (dateStr) => {
  if (!dateStr || dateStr === 'Present') return null;
  const [month, year] = dateStr.split('/');
  return `${year}-${month}-01`;
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{personal.name} | Actions Run</title>
  </head>
  <body class="bg-[#0d1117] text-[#c9d1d9] font-mono min-h-screen p-4 md:p-8">
    <div class="max-w-4xl mx-auto">
      
      <!-- Pipeline header -->
      <div class="border-b border-gray-700 pb-4 mb-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <h1 class="text-xl font-bold flex items-center gap-2">
          <svg class="w-6 h-6 text-green-500" fill="currentColor" viewBox="0 0 16 16"><path d="M8 16A8 8 0 108 0a8 8 0 000 16zm3.78-9.72a.75.75 0 00-1.06-1.06L6.75 9.19 5.28 7.72a.75.75 0 00-1.06 1.06l2 2a.75.75 0 001.06 0l4.5-4.5z"></path></svg>
          Ilia Levinskii
        </h1>
        
        <div class="flex items-center gap-3 flex-wrap">
          <span class="text-gray-400 text-sm hidden lg:inline mr-2">#1 run successful</span>
          
          <!-- Email button -->
          <a 
            href={`mailto:${personal.email}`}
            class="flex items-center gap-2 px-3 py-1.5 text-sm font-semibold bg-[#21262d] hover:bg-[#30363d] border border-gray-600 rounded-md transition-colors select-none"
          >
            <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            Email Me
          </a>

          <!-- LinkedIn button -->
          <a 
            href={`https://${personal.linkedin}`}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-3 py-1.5 text-sm font-semibold bg-[#21262d] hover:bg-[#30363d] border border-gray-600 rounded-md transition-colors select-none"
          >
            <svg class="w-4 h-4 text-[#0a66c2]" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>

          <!-- Classic CV button -->
          <a 
            href="/portfolio/resume"
            class="flex items-center gap-2 px-3 py-1.5 text-sm font-semibold bg-[#21262d] hover:bg-[#30363d] border border-gray-600 rounded-md transition-colors select-none"
          >
            <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            Classic CV
          </a>
          
          <!-- PDF button -->
          <button 
            id="print-btn"
            onclick="window.print()"
            class="flex items-center gap-2 px-3 py-1.5 text-sm font-semibold bg-[#21262d] hover:bg-[#30363d] border border-gray-600 rounded-md transition-colors cursor-pointer select-none"
          >
            <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
            PDF
          </button>
        </div>
      </div>

      <!-- Job 1: Profile -->
      <div class="mb-8">
        <div class="flex items-center space-x-2 mb-4 font-bold text-lg">
          <span class="text-blue-400">▶</span>
          <span>Job: checkout_profile</span>
        </div>
        
        <ActionStep title="Run whoami" time="0s" isOpen={true}>
          <div class="flex hover:bg-[#161b22] px-2 py-0.5 rounded">
            <span class="text-gray-600 w-6 text-right select-none mr-3 shrink-0">1</span>
            <span class="text-gray-300 break-words">Name: {personal.name}</span>
          </div>
          <div class="flex hover:bg-[#161b22] px-2 py-0.5 rounded">
            <span class="text-gray-600 w-6 text-right select-none mr-3 shrink-0">2</span>
            <span class="text-gray-300 break-words">Role: {personal.role}</span>
          </div>
          <div class="flex hover:bg-[#161b22] px-2 py-0.5 rounded">
            <span class="text-gray-600 w-6 text-right select-none mr-3 shrink-0">3</span>
            <span class="text-gray-300 break-words">Location: {personal.location}</span>
          </div>
          <div class="flex hover:bg-[#161b22] px-2 py-0.5 rounded">
            <span class="text-gray-600 w-6 text-right select-none mr-3 shrink-0">4</span>
            <span class="text-gray-300 break-words">Email: {personal.email}</span>
          </div>
          <div class="flex hover:bg-[#161b22] px-2 py-0.5 rounded">
            <span class="text-gray-600 w-6 text-right select-none mr-3 shrink-0">5</span>
            <span class="text-gray-300 break-words">LinkedIn: {personal.linkedin}</span>
          </div>
        </ActionStep>
      </div>

      <!-- Job 2: Experience -->
      <div class="mb-8">
        <div class="flex items-center space-x-2 mb-4 font-bold text-lg">
          <span class="text-blue-400">▶</span>
          <span>Job: execute_career_steps</span>
        </div>

        {experience.map((job) => {
          let lineCounter = 1; // reset for each job position
          return (
            <ActionStep 
              title={`Run ${job.title} @ ${job.company}`}
              startDate={parseDate(job.startDate)} 
              endDate={parseDate(job.endDate)}
              active={job.endDate === 'Present'}
            >
              {job.projects.map((project) => (
                <div class="mb-2 last:mb-0">
                  {project.name && (
                    <div class="flex hover:bg-[#161b22] px-2 py-0.5 rounded">
                      <span class="text-gray-600 w-6 text-right select-none mr-3 shrink-0">{lineCounter++}</span>
                      <span class="text-blue-300 font-semibold break-words"># {project.name}</span>
                    </div>
                  )}
                  {project.achievements.map((achieve) => (
                    <div class="flex hover:bg-[#161b22] px-2 py-0.5 rounded">
                      <span class="text-gray-600 w-6 text-right select-none mr-3 shrink-0">{lineCounter++}</span>
                      <span class="text-gray-300 break-words">{achieve}</span>
                    </div>
                  ))}
                </div>
              ))}
            </ActionStep>
          );
        })}
      </div>
      
      <!-- Job 3: Skills and Certificates -->
      <div class="mt-8 mb-12">
        <div class="flex items-center space-x-2 mb-4 font-bold text-lg">
          <span class="text-blue-400">▶</span>
          <span>Job: verify_dependencies</span>
        </div>
        
        <ActionStep title="Run analyze_skills.sh" time="2s">
          {Object.entries(skills).map(([category, items], i) => (
            <div class="flex hover:bg-[#161b22] px-2 py-0.5 rounded">
              <span class="text-gray-600 w-6 text-right select-none mr-3 shrink-0">{i + 1}</span>
              <span class="text-gray-300 break-words"><strong>{category}:</strong> {items.join(', ')}</span>
            </div>
          ))}
        </ActionStep>

        <ActionStep title="Run validate_certificates.sh" time="1s">
          {certifications.map((cert, i) => (
            <div class="flex hover:bg-[#161b22] px-2 py-0.5 rounded">
              <span class="text-gray-600 w-6 text-right select-none mr-3 shrink-0">{i + 1}</span>
              <span class="text-gray-300 break-words">{cert}</span>
            </div>
          ))}
        </ActionStep>
      </div>

    </div>

    </div>
  </body>
</html>